        /* ============================================= */
        /* Homepage JavaScript - Generated from modules */
        /* ============================================= */

        /* Module: 01-constants-and-cache.js */
        /**
         * Module: Constants and DOM Cache
         * Defines configuration constants, DOM element cache, and CSS class names
         */

        const CLOCK_FORMAT = '{{ clock_format }}';
        const RELOAD_INTERVAL = {{ reload_interval }};

        /**
         * Cached DOM elements for performance
         * Initialized on DOMContentLoaded to avoid repeated queries
         */
        const DOM = {
            clock: null,
            date: null,
            weather: null,
            weatherForecast: null,
            rssWidget: null,
            searchInput: null,
            searchProvider: null,
            linksContainer: null,
            widgetsContainer: null,
            editToggle: null,
            editIcon: null,
            editText: null,
            editModal: null,
            modalTitle: null,
            itemName: null,
            itemIcon: null,
            itemUrl: null,
            urlGroup: null,
            confirmModal: null,
            confirmMessage: null,
            statsToggle: null,
            systemStatsSidebar: null,
            statsSlimBar: null,
            statsExpandedContent: null
        };

        /**
         * Initialize DOM cache
         * Call this once on DOMContentLoaded
         */
        function initDOMCache() {
            DOM.clock = document.getElementById('clock');
            DOM.date = document.getElementById('date');
            DOM.weather = document.getElementById('weather');
            DOM.weatherForecast = document.getElementById('weatherForecast');
            DOM.rssWidget = document.getElementById('rssWidget');
            DOM.searchInput = document.getElementById('searchInput');
            DOM.searchProvider = document.getElementById('searchProvider');
            DOM.linksContainer = document.getElementById('linksContainer');
            DOM.widgetsContainer = document.getElementById('widgetsContainer');
            DOM.editToggle = document.getElementById('editToggle');
            DOM.editIcon = document.getElementById('editIcon');
            DOM.editText = document.getElementById('editText');
            DOM.editModal = document.getElementById('editModal');
            DOM.modalTitle = document.getElementById('modalTitle');
            DOM.itemName = document.getElementById('itemName');
            DOM.itemIcon = document.getElementById('itemIcon');
            DOM.itemUrl = document.getElementById('itemUrl');
            DOM.urlGroup = document.getElementById('urlGroup');
            DOM.confirmModal = document.getElementById('confirmModal');
            DOM.confirmMessage = document.getElementById('confirmMessage');
            DOM.statsToggle = document.getElementById('statsToggle');
            DOM.systemStatsSidebar = document.getElementById('systemStatsSidebar');
            DOM.statsSlimBar = document.getElementById('statsSlimBar');
            DOM.statsExpandedContent = document.getElementById('statsExpandedContent');
        }

        /**
         * CSS class names as constants to avoid typos
         */
        const CSS_CLASSES = {
            EDIT_MODE: 'edit-mode',
            ACTIVE: 'active',
            SHOW: 'show',
            POSITION_LEFT: 'position-left',
            POSITION_RIGHT: 'position-right',
            POSITION_TOP: 'position-top',
            POSITION_BOTTOM: 'position-bottom'
        };

        /* Module: 02-clock.js */
        /**
         * Module: Clock and Date
         * Handles clock and date display updates
         */

        /**
         * Update the clock display
         * Uses 12h or 24h format based on CLOCK_FORMAT constant
         */
        function updateClock() {
            if (!DOM.clock) return;

            const now = new Date();
            let hours = now.getHours();
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');

            if (CLOCK_FORMAT === '12') {
                const ampm = hours >= 12 ? 'PM' : 'AM';
                hours = hours % 12 || 12;
                DOM.clock.textContent = `${hours}:${minutes}:${seconds} ${ampm}`;
            } else {
                hours = String(hours).padStart(2, '0');
                DOM.clock.textContent = `${hours}:${minutes}:${seconds}`;
            }
        }

        /**
         * Update the date display
         */
        function updateDate() {
            if (!DOM.date) return;

            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const dateString = now.toLocaleDateString('en-US', options);
            DOM.date.textContent = dateString;
        }

        /* Module: 03-weather.js */
        /**
         * Module: Weather and Forecast
         * Handles weather data fetching and display
         */

        {% if config.ENABLE_WEATHER %}
        /**
         * Fetch and display current weather
         */
        function updateWeather() {
            if (!DOM.weather) return;

            fetch('/api/weather')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.error) {
                        DOM.weather.innerHTML = `<span class="weather-loading">Weather unavailable</span>`;
                        console.warn('Weather API error:', data.error);
                        return;
                    }

                    const tempUnit = data.units === 'metric' ? '°C' : '°F';
                    const windUnit = data.units === 'metric' ? 'km/h' : 'mph';

                    DOM.weather.innerHTML = `
                        <span class="weather-location">${data.location}</span>
                        <span class="weather-temp">${Math.round(data.temperature)}${tempUnit}</span>
                        <span class="weather-desc">${data.description}</span>
                        <span class="weather-details">
                            <span>💧 ${data.humidity}%</span>
                            <span>💨 ${Math.round(data.wind_speed)} ${windUnit}</span>
                        </span>
                    `;
                })
                .catch(error => {
                    // Silently fail for network errors (don't spam console)
                    if (error.message.includes('NetworkError') || error.message.includes('Failed to fetch')) {
                        DOM.weather.innerHTML = `<span class="weather-loading">No network</span>`;
                    } else {
                        DOM.weather.innerHTML = `<span class="weather-loading">Weather unavailable</span>`;
                        console.warn('Weather fetch failed:', error.message);
                    }
                });
        }

        let forecastMode = 'daily';

        /**
         * Template for forecast item (daily)
         */
        function createDailyForecastItem(item, tempUnit) {
            const precipDisplay = item.precipitation_probability > 0
                ? `<div class="forecast-precip">${item.precipitation_probability}%</div>`
                : '';

            return `
                <div class="forecast-item">
                    <div class="forecast-day">${item.day}</div>
                    <div class="forecast-emoji">${item.weather_emoji}</div>
                    <div class="forecast-temp-range">${item.temperature_max}/${item.temperature_min}${tempUnit}</div>
                    ${precipDisplay}
                </div>
            `;
        }

        /**
         * Template for forecast item (hourly)
         */
        function createHourlyForecastItem(item, tempUnit) {
            const precipDisplay = item.precipitation_probability > 0
                ? `<div class="forecast-precip">${item.precipitation_probability}%</div>`
                : '';

            return `
                <div class="forecast-item">
                    <div class="forecast-time">${item.hour}</div>
                    <div class="forecast-emoji">${item.weather_emoji}</div>
                    <div class="forecast-temp">${item.temperature}${tempUnit}</div>
                    ${precipDisplay}
                </div>
            `;
        }

        /**
         * Fetch and display weather forecast (hourly or daily)
         */
        function updateWeatherForecast() {
            if (!DOM.weatherForecast) return;

            const endpoint = forecastMode === 'daily' ? '/api/weather/forecast/daily' : '/api/weather/forecast';

            fetch(endpoint)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    const forecastData = forecastMode === 'daily' ? data.daily : data.hourly;
                    if (data.error || !forecastData || forecastData.length === 0) {
                        DOM.weatherForecast.innerHTML = `<div class="forecast-loading">Forecast unavailable</div>`;
                        return;
                    }

                    const tempUnit = data.units === 'metric' ? '°C' : '°F';
                    const containerClass = forecastMode === 'daily' ? 'forecast-days' : 'forecast-hours';

                    const itemsHtml = forecastMode === 'daily'
                        ? forecastData.map(item => createDailyForecastItem(item, tempUnit)).join('')
                        : forecastData.map(item => createHourlyForecastItem(item, tempUnit)).join('');

                    DOM.weatherForecast.innerHTML = `<div class="${containerClass}">${itemsHtml}</div>`;
                })
                .catch(error => {
                    if (!error.message.includes('NetworkError') && !error.message.includes('Failed to fetch')) {
                        console.warn('Forecast fetch failed:', error.message);
                    }
                    DOM.weatherForecast.innerHTML = `<div class="forecast-loading">Forecast unavailable</div>`;
                });
        }
        {% endif %}

        /* Module: 04-rss.js */
        /**
         * Module: RSS Feed Carousel
         * Handles RSS feed display and navigation
         */

        {% if config.ENABLE_RSS %}
        let rssItems = [];
        let currentRSSIndex = 0;
        let rssAutoRotate = null;

        /**
         * Fetch RSS feeds from server
         */
        function updateRSSFeeds() {
            if (!DOM.rssWidget) return;

            fetch('/api/rss')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.error || !data.items || data.items.length === 0) {
                        DOM.rssWidget.innerHTML = `<div class="rss-error">No RSS items available</div>`;
                        return;
                    }

                    rssItems = data.items;
                    currentRSSIndex = 0;
                    renderRSSCarousel();
                    startRSSAutoRotate();
                })
                .catch(error => {
                    DOM.rssWidget.innerHTML = `<div class="rss-error">RSS feeds unavailable</div>`;
                    console.warn('RSS fetch failed:', error.message);
                });
        }

        /**
         * Render RSS carousel with navigation
         */
        function renderRSSCarousel() {
            if (!DOM.rssWidget || rssItems.length === 0) return;

            const itemsHtml = rssItems.map(item => {
                const date = item.published ? new Date(item.published).toLocaleDateString() : '';
                const description = item.description ? `<div class="rss-item-description">${item.description}</div>` : '';

                return `
                    <div class="rss-item">
                        <a href="${item.link}" target="_blank" rel="noopener noreferrer" class="rss-item-link">
                            ${item.title}
                        </a>
                        <div class="rss-item-meta">
                            <span class="rss-item-feed">${item.feed_title}</span>
                            ${date ? `<span class="rss-item-date">${date}</span>` : ''}
                        </div>
                        ${description}
                    </div>
                `;
            }).join('');

            DOM.rssWidget.innerHTML = `
                <div class="rss-title">
                    <span>📰 Latest News</span>
                    <div class="rss-nav">
                        <button class="rss-nav-btn" data-action="rss-prev" aria-label="Previous">‹</button>
                        <span class="rss-counter">${currentRSSIndex + 1} / ${rssItems.length}</span>
                        <button class="rss-nav-btn" data-action="rss-next" aria-label="Next">›</button>
                    </div>
                </div>
                <div class="rss-carousel">
                    <div class="rss-items" style="transform: translateX(-${currentRSSIndex * 100}%)">
                        ${itemsHtml}
                    </div>
                </div>
            `;

            // Attach event listeners to navigation buttons
            DOM.rssWidget.querySelector('[data-action="rss-prev"]').addEventListener('click', prevRSSItem);
            DOM.rssWidget.querySelector('[data-action="rss-next"]').addEventListener('click', nextRSSItem);
        }

        /**
         * Navigate to next RSS item
         */
        function nextRSSItem() {
            if (rssItems.length === 0) return;
            currentRSSIndex = (currentRSSIndex + 1) % rssItems.length;
            renderRSSCarousel();
            resetRSSAutoRotate();
        }

        /**
         * Navigate to previous RSS item
         */
        function prevRSSItem() {
            if (rssItems.length === 0) return;
            currentRSSIndex = (currentRSSIndex - 1 + rssItems.length) % rssItems.length;
            renderRSSCarousel();
            resetRSSAutoRotate();
        }

        /**
         * Start auto-rotation timer for RSS feed
         */
        function startRSSAutoRotate() {
            if (rssAutoRotate) clearInterval(rssAutoRotate);
            rssAutoRotate = setInterval(() => {
                nextRSSItem();
            }, 30000); // 30 seconds
        }

        /**
         * Reset auto-rotation timer
         */
        function resetRSSAutoRotate() {
            startRSSAutoRotate();
        }
        {% endif %}

        /* Module: 05-search.js */
        /**
         * Module: Search and Tracking
         * Handles search functionality and event tracking
         */

        /**
         * Check if page reload is needed (config changes)
         */
        function checkForReload() {
            // Don't reload if in edit mode - user is actively editing
            if (editMode) {
                return;
            }

            fetch('/check_reload')
                .then(response => response.json())
                .then(data => {
                    if (data.reload) {
                        window.location.reload();
                    }
                })
                .catch(error => console.error('Error checking for reload:', error));
        }

        /**
         * Handle search form submission
         */
        function handleSearch(event) {
            event.preventDefault();

            if (!DOM.searchInput || !DOM.searchProvider) return;

            const query = DOM.searchInput.value.trim();

            if (!query) {
                return;
            }

            const searchUrls = {
                'brave': 'https://search.brave.com/search?q=',
                'google': 'https://www.google.com/search?q=',
                'duckduckgo': 'https://duckduckgo.com/?q=',
                'bing': 'https://www.bing.com/search?q='
            };

            const baseUrl = searchUrls[DOM.searchProvider.value] || searchUrls['brave'];
            const searchUrl = baseUrl + encodeURIComponent(query);

            // Track search
            trackEvent('search', { provider: DOM.searchProvider.value, query: query });

            window.open(searchUrl, '_blank', 'noopener,noreferrer');

            // Save to search history
            saveSearchHistory(query, DOM.searchProvider.value);
            DOM.searchInput.value = '';
        }

        /**
         * Save search query to local storage
         */
        function saveSearchHistory(query, provider) {
            try {
                let history = JSON.parse(localStorage.getItem('searchHistory') || '[]');
                history.unshift({ query, provider, timestamp: Date.now() });
                history = history.slice(0, 50); // Keep last 50 searches
                localStorage.setItem('searchHistory', JSON.stringify(history));
            } catch (e) {
                console.error('Failed to save search history:', e);
            }
        }

        /**
         * Track events to server (analytics)
         */
        function trackEvent(eventType, data) {
            // Send tracking data to server
            fetch('/api/track', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ event: eventType, data: data, timestamp: Date.now() })
            }).catch(() => {}); // Silently fail
        }

        /* Module: 06-system-stats.js */
        /**
         * Module: System Stats Sidebar
         * Handles real-time system statistics display
         */

        {% if config.ENABLE_SYSTEM_STATS %}
        // System stats state
        let systemStatsVisible = false;
        let systemStatsInterval = null;
        let systemStatsPosition = 'left';
        let cpuHistory = [];
        let memoryHistory = [];
        const maxHistoryPoints = 20;

        function toggleSystemStats() {
            systemStatsVisible = !systemStatsVisible;
            const sidebar = document.getElementById('systemStatsSidebar');
            const expandedContent = document.getElementById('statsExpandedContent');
            const slimBar = document.getElementById('statsSlimBar');

            if (systemStatsVisible) {
                sidebar.classList.add('expanded');
                expandedContent.style.display = 'block';
                slimBar.style.display = 'none';
                updateSystemStats();
                systemStatsInterval = setInterval(updateSystemStats, 5000);
            } else {
                sidebar.classList.remove('expanded');
                expandedContent.style.display = 'none';
                slimBar.style.display = 'block';
                if (systemStatsInterval) {
                    clearInterval(systemStatsInterval);
                    systemStatsInterval = null;
                }
            }
        }

        function setStatsPosition(position) {
            const sidebar = document.getElementById('systemStatsSidebar');
            sidebar.classList.remove('position-left', 'position-right', 'position-top', 'position-bottom');
            sidebar.classList.add(`position-${position}`);
            systemStatsPosition = position;
            localStorage.setItem('statsPosition', position);
        }

        function updateSystemStats() {
            fetch('/api/system-stats')
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        console.error('System stats error:', data.error);
                        return;
                    }

                    // Update icon panel and slim bar
                    const cpuPercent = `${Math.round(data.cpu_percent)}%`;
                    const memoryPercent = `${Math.round(data.memory_percent)}%`;
                    const diskPercent = `${Math.round(data.disk_percent)}%`;
                    const networkTotal = `${(data.network_sent_mb + data.network_recv_mb).toFixed(1)}M`;

                    document.getElementById('cpuIconValue').textContent = cpuPercent;
                    document.getElementById('memoryIconValue').textContent = memoryPercent;
                    document.getElementById('diskIconValue').textContent = diskPercent;
                    document.getElementById('networkIconValue').textContent = networkTotal;

                    document.getElementById('cpuSlimValue').textContent = cpuPercent;
                    document.getElementById('memorySlimValue').textContent = memoryPercent;
                    document.getElementById('diskSlimValue').textContent = diskPercent;
                    document.getElementById('networkSlimValue').textContent = networkTotal;

                    // Update CPU section
                    updateStatBar('cpuBar', data.cpu_percent);
                    document.getElementById('cpuValue').textContent = `${Math.round(data.cpu_percent)}%`;
                    document.getElementById('cpuCores').textContent = `${data.cpu_count} cores`;
                    document.getElementById('cpuFreq').textContent = `${Math.round(data.cpu_freq_current)} MHz`;

                    // Update CPU sparkline
                    cpuHistory.push(data.cpu_percent);
                    if (cpuHistory.length > maxHistoryPoints) cpuHistory.shift();
                    updateSparkline('cpuSparklinePath', cpuHistory);

                    // Update Memory section
                    updateStatBar('memoryBar', data.memory_percent);
                    document.getElementById('memoryValue').textContent = `${Math.round(data.memory_percent)}%`;
                    document.getElementById('memoryUsed').textContent = `${Math.round(data.memory_used_mb)} MB`;
                    document.getElementById('memoryTotal').textContent = `${Math.round(data.memory_total_mb)} MB`;

                    // Update Memory sparkline
                    memoryHistory.push(data.memory_percent);
                    if (memoryHistory.length > maxHistoryPoints) memoryHistory.shift();
                    updateSparkline('memorySparklinePath', memoryHistory);

                    // Update Disk section
                    updateStatBar('diskBar', data.disk_percent);
                    document.getElementById('diskValue').textContent = `${Math.round(data.disk_percent)}%`;
                    document.getElementById('diskUsed').textContent = `${data.disk_used_gb.toFixed(1)} GB`;
                    document.getElementById('diskTotal').textContent = `${data.disk_total_gb.toFixed(1)} GB`;

                    // Update Network section
                    document.getElementById('networkRecv').textContent = `${data.network_recv_mb.toFixed(1)} MB`;
                    document.getElementById('networkSent').textContent = `${data.network_sent_mb.toFixed(1)} MB`;

                    // Update Battery section (conditional)
                    if (data.battery) {
                        const batterySection = document.getElementById('batterySection');
                        batterySection.style.display = 'block';
                        updateStatBar('batteryBar', data.battery.percent);
                        document.getElementById('batteryValue').textContent = `${Math.round(data.battery.percent)}%`;

                        let statusText = data.battery.plugged ? '🔌 Charging' : '🔋 Discharging';
                        if (data.battery.time_left) {
                            const hours = Math.floor(data.battery.time_left / 3600);
                            const minutes = Math.floor((data.battery.time_left % 3600) / 60);
                            statusText += ` (${hours}h ${minutes}m)`;
                        }
                        document.getElementById('batteryStatus').textContent = statusText;
                    }

                    // Update System info
                    document.getElementById('processCount').textContent = data.processes;
                    document.getElementById('uptime').textContent = formatUptime(data.uptime_seconds);

                    // Update Temperature (conditional)
                    if (data.temperature_avg !== undefined) {
                        document.getElementById('temperatureInfo').style.display = 'inline';
                        document.getElementById('temperature').textContent = Math.round(data.temperature_avg);
                    }
                })
                .catch(error => {
                    console.error('Failed to fetch system stats:', error);
                });
        }

        function updateStatBar(barId, percentage) {
            const bar = document.getElementById(barId);
            bar.style.setProperty('--bar-width', `${percentage}%`);
        }

        function updateSparkline(pathId, data) {
            if (data.length === 0) return;

            const points = data.map((value, index) => {
                const x = (index / (maxHistoryPoints - 1)) * 120;
                const y = 30 - (value / 100) * 30;
                return `${x},${y}`;
            }).join(' ');

            document.getElementById(pathId).setAttribute('points', points);
        }

        function formatUptime(seconds) {
            const days = Math.floor(seconds / 86400);
            const hours = Math.floor((seconds % 86400) / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);

            if (days > 0) return `${days}d ${hours}h ${minutes}m`;
            if (hours > 0) return `${hours}h ${minutes}m`;
            return `${minutes}m`;
        }

        // Initialize system stats sidebar
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('systemStatsSidebar');
            setStatsPosition(systemStatsPosition);
            // Start updating slim bar immediately
            updateSystemStats();
            setInterval(updateSystemStats, 5000);
        });

        // Add keyboard shortcut for system stats (s key)
        document.addEventListener('keydown', (e) => {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
            if (e.key === 's' || e.key === 'S') {
                e.preventDefault();
                toggleSystemStats();
            }
        });



