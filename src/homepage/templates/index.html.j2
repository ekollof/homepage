<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homepage</title>
    <link rel="icon" href="{{ url_for('assets.favicon') }}" type="image/png">
    <link rel="stylesheet" href="{{ url_for('assets.styles') }}">
</head>
<body>
    <div class="overlay">
    </style>
</head>
<body>
    <!-- Top-right button container -->
    <div class="top-buttons-container">
        {% if config.ENABLE_SYSTEM_STATS %}
        <button class="stats-toggle" id="statsToggle">
            <span>📊</span>
        </button>
        {% endif %}
        {% if config.ENABLE_EDITING %}
        <button class="edit-toggle" id="editToggle">
            <span id="editIcon">✏️</span>
            <span id="editText">Edit Mode</span>
        </button>
        {% endif %}
    </div>

    {% if config.ENABLE_SYSTEM_STATS %}
    <!-- System Stats Sidebar -->
    <div class="system-stats-sidebar position-left" id="systemStatsSidebar">
        <!-- Slim iconized bar (always visible when sidebar is not expanded) -->
        <div class="stats-slim-bar" id="statsSlimBar" data-action="toggle-stats">
            <div class="slim-stat" title="CPU">
                <span class="slim-icon">💻</span>
                <span class="slim-value" id="cpuSlimValue">--</span>
            </div>
            <div class="slim-stat" title="Memory">
                <span class="slim-icon">🧠</span>
                <span class="slim-value" id="memorySlimValue">--</span>
            </div>
            <div class="slim-stat" title="Disk">
                <span class="slim-icon">💾</span>
                <span class="slim-value" id="diskSlimValue">--</span>
            </div>
            <div class="slim-stat" title="Network">
                <span class="slim-icon">🌐</span>
                <span class="slim-value" id="networkSlimValue">--</span>
            </div>
        </div>

        <!-- Expanded content -->
        <div class="stats-expanded-content" id="statsExpandedContent" style="display: none;">
            <div class="stats-header">
                <span class="stats-title">System Stats</span>
                <div class="stats-position-controls">
                    <button class="position-btn" data-action="set-stats-position" data-position="left" title="Left">⬅️</button>
                    <button class="position-btn" data-action="set-stats-position" data-position="right" title="Right">➡️</button>
                    <button class="position-btn" data-action="set-stats-position" data-position="top" title="Top">⬆️</button>
                    <button class="position-btn" data-action="set-stats-position" data-position="bottom" title="Bottom">⬇️</button>
                </div>
                <button class="stats-close" data-action="toggle-stats" title="Collapse">◀</button>
            </div>

            <div class="stats-content">
                <!-- Iconized Panel -->
                <div class="stats-icon-panel">
                <div class="stat-icon" title="CPU">
                    <span class="icon">💻</span>
                    <span class="value" id="cpuIconValue">--</span>
                </div>
                <div class="stat-icon" title="Memory">
                    <span class="icon">🧠</span>
                    <span class="value" id="memoryIconValue">--</span>
                </div>
                <div class="stat-icon" title="Disk">
                    <span class="icon">💾</span>
                    <span class="value" id="diskIconValue">--</span>
                </div>
                <div class="stat-icon" title="Network">
                    <span class="icon">🌐</span>
                    <span class="value" id="networkIconValue">--</span>
                </div>
            </div>

            <!-- Detailed Stats (expandable) -->
            <div class="stats-details" id="statsDetails">
                <!-- CPU Section -->
                <div class="stat-section">
                    <div class="stat-label">CPU Usage</div>
                    <div class="stat-bar-container">
                        <div class="stat-bar" id="cpuBar"></div>
                        <span class="stat-value" id="cpuValue">--</span>
                    </div>
                    <div class="stat-info">
                        <span id="cpuCores">-- cores</span> •
                        <span id="cpuFreq">-- MHz</span>
                    </div>
                    <div class="sparkline-container">
                        <svg class="sparkline" id="cpuSparkline" viewBox="0 0 120 30" preserveAspectRatio="none">
                            <polyline id="cpuSparklinePath" fill="none" stroke="{{ colors.color2 }}" stroke-width="1.5"></polyline>
                        </svg>
                    </div>
                </div>

                <!-- Memory Section -->
                <div class="stat-section">
                    <div class="stat-label">Memory Usage</div>
                    <div class="stat-bar-container">
                        <div class="stat-bar" id="memoryBar"></div>
                        <span class="stat-value" id="memoryValue">--</span>
                    </div>
                    <div class="stat-info">
                        <span id="memoryUsed">-- MB</span> /
                        <span id="memoryTotal">-- MB</span>
                    </div>
                    <div class="sparkline-container">
                        <svg class="sparkline" id="memorySparkline" viewBox="0 0 120 30" preserveAspectRatio="none">
                            <polyline id="memorySparklinePath" fill="none" stroke="{{ colors.color4 }}" stroke-width="1.5"></polyline>
                        </svg>
                    </div>
                </div>

                <!-- Disk Section -->
                <div class="stat-section">
                    <div class="stat-label">Disk Usage</div>
                    <div class="stat-bar-container">
                        <div class="stat-bar" id="diskBar"></div>
                        <span class="stat-value" id="diskValue">--</span>
                    </div>
                    <div class="stat-info">
                        <span id="diskUsed">-- GB</span> /
                        <span id="diskTotal">-- GB</span>
                    </div>
                </div>

                <!-- Network Section -->
                <div class="stat-section">
                    <div class="stat-label">Network I/O</div>
                    <div class="stat-info">
                        ↓ <span id="networkRecv">-- MB</span> •
                        ↑ <span id="networkSent">-- MB</span>
                    </div>
                </div>

                <!-- Battery Section (conditional) -->
                <div class="stat-section" id="batterySection" style="display: none;">
                    <div class="stat-label">Battery</div>
                    <div class="stat-bar-container">
                        <div class="stat-bar" id="batteryBar"></div>
                        <span class="stat-value" id="batteryValue">--</span>
                    </div>
                    <div class="stat-info" id="batteryInfo">
                        <span id="batteryStatus">--</span>
                    </div>
                </div>

                <!-- System Info -->
                <div class="stat-section">
                    <div class="stat-label">System</div>
                    <div class="stat-info">
                        Processes: <span id="processCount">--</span><br>
                        Uptime: <span id="uptime">--</span>
                        <span id="temperatureInfo" style="display: none;"><br>Temp: <span id="temperature">--</span>°C</span>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </div>
    {% endif %}

    <div class="overlay">
        <div class="container">
            <div class="header">
                <div class="clock" id="clock">00:00:00</div>
                <div class="date" id="date">Loading...</div>

                <div class="widgets-container" id="widgetsContainer">
                    {% if config.ENABLE_WEATHER %}
                    <div class="widget-wrapper" data-widget="weather" draggable="false">
                        <span class="widget-drag-handle">⋮⋮</span>
                        <div class="weather" id="weather">
                            <span class="weather-loading">Loading weather...</span>
                        </div>
                        <button class="forecast-expand-btn" id="forecastExpandBtn">📅 Show Forecast</button>
                        <div class="forecast-container" id="forecastContainer" style="display: none;">
                            <div class="forecast-controls">
                                <button class="forecast-toggle-btn" id="forecastModeToggle">Daily</button>
                            </div>
                            <div class="weather-forecast" id="weatherForecast">
                                <div class="forecast-loading">Loading forecast...</div>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {% if config.ENABLE_RSS %}
                    <div class="widget-wrapper" data-widget="rss" draggable="false">
                        <span class="widget-drag-handle">⋮⋮</span>
                        <div class="rss-widget" id="rssWidget">
                            <div class="rss-loading">Loading RSS feeds...</div>
                        </div>
                    </div>
                    {% endif %}
                </div>

                <div class="search-container">
                    <form class="search-form" onsubmit="handleSearch(event)">
                        <select class="search-provider" id="searchProvider">
                            <option value="brave">Brave Search</option>
                            <option value="google">Google</option>
                            <option value="duckduckgo">DuckDuckGo</option>
                            <option value="bing">Bing</option>
                        </select>
                        <input
                            type="text"
                            class="search-input"
                            id="searchInput"
                            placeholder="Search the web..."
                            autocomplete="off"
                        />
                    </form>
                    <div class="keyboard-shortcuts">
                        Press <kbd>?</kbd> for keyboard shortcuts
                    </div>
                </div>
            </div>

            <div class="links-container" id="linksContainer">
                {% for category in categories %}
                <div class="category" data-category-index="{{ loop.index0 }}" draggable="false">
                    <span class="category-drag-handle">⋮⋮</span>
                    <div class="category-title">
                        <span class="category-icon">{{ category.icon }}</span>
                        <span>{{ category.name }}</span>
                    </div>

                    {% if category.links %}
                    <ul class="links-list">
                        {% for link in category.links %}
                        <li class="link-item" data-link-index="{{ loop.index0 }}" draggable="false">
                            <span class="link-drag-handle">⋮⋮</span>
                            <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer" data-link="{{ link.name }}">
                                <span class="link-icon">
                                    {% if link.icon %}
                                        {% if link.icon.startswith('data:image/') %}
                                            <img src="{{ link.icon }}" alt="" style="width: 1em; height: 1em; vertical-align: middle;">
                                        {% else %}
                                            {{ link.icon }}
                                        {% endif %}
                                    {% else %}
                                        <img src="https://www.google.com/s2/favicons?domain={{ link.url }}&sz=32" alt="" style="width: 1em; height: 1em; vertical-align: middle;" onerror="this.style.display='none'">
                                    {% endif %}
                                </span>
                                <span>{{ link.name }}</span>
                            </a>
                            <div class="edit-controls link-controls">
                                <button class="edit-btn edit-btn-small" onclick="editLink(this, false, event)">Edit</button>
                                <button class="edit-btn edit-btn-small danger" onclick="deleteLink(this, false, event)">×</button>
                            </div>
                        </li>
                        {% endfor %}
                    </ul>
                    {% endif %}

                    {% if category.subcategory %}
                    {% for subcategory in category.subcategory %}
                    <div class="subcategory" data-subcategory-index="{{ loop.index0 }}" draggable="false">
                        <div class="subcategory-title">
                            <span class="subcategory-drag-handle">⋮⋮</span>
                            <span class="subcategory-icon">{{ subcategory.icon }}</span>
                            <span>{{ subcategory.name }}</span>
                        </div>
                        {% if subcategory.links %}
                        <ul class="links-list">
                            {% for link in subcategory.links %}
                            <li class="link-item" data-link-index="{{ loop.index0 }}" draggable="false">
                                <span class="link-drag-handle">⋮⋮</span>
                                <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer" data-link="{{ link.name }}">
                                    <span class="link-icon">
                                        {% if link.icon %}
                                            {% if link.icon.startswith('data:image/') %}
                                                <img src="{{ link.icon }}" alt="" style="width: 1em; height: 1em; vertical-align: middle;">
                                            {% else %}
                                                {{ link.icon }}
                                            {% endif %}
                                        {% else %}
                                            <img src="https://www.google.com/s2/favicons?domain={{ link.url }}&sz=32" alt="" style="width: 1em; height: 1em; vertical-align: middle;" onerror="this.style.display='none'">
                                        {% endif %}
                                    </span>
                                    <span>{{ link.name }}</span>
                                </a>
                                <div class="edit-controls link-controls">
                                    <button class="edit-btn edit-btn-small" onclick="editLink(this, true, event)">Edit</button>
                                    <button class="edit-btn edit-btn-small danger" onclick="deleteLink(this, true, event)">×</button>
                                </div>
                            </li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                        <div class="edit-controls">
                            <button class="edit-btn" onclick="editSubcategory(this)">Edit Subcategory</button>
                            <button class="edit-btn add" onclick="addLink(this, true)">+ Link</button>
                            <button class="edit-btn danger" onclick="deleteSubcategory(this)">Delete</button>
                        </div>
                    </div>
                    {% endfor %}
                    {% endif %}

                    <div class="edit-controls">
                        <button class="edit-btn" onclick="editCategory(this)">Edit Category</button>
                        <button class="edit-btn add" onclick="addLink(this, false)">+ Link</button>
                        <button class="edit-btn add" onclick="addSubcategory(this)">+ Subcategory</button>
                        <button class="edit-btn danger" onclick="deleteCategory(this)">Delete</button>
                    </div>
                </div>
                {% endfor %}

                <div class="edit-controls add-category-container">
                    <button class="edit-btn add" onclick="addCategory()" style="font-size: 1rem; padding: 10px 20px;">+ Add Category</button>
                </div>
            </div>
        </div>
    </div>

    <div class="help-overlay" id="helpOverlay">
        <div class="help-content">
            <h2>Keyboard Shortcuts</h2>
            <table>
                <tr>
                    <td><kbd>/</kbd></td>
                    <td>Focus search bar</td>
                </tr>
                <tr>
                    <td><kbd>?</kbd></td>
                    <td>Show this help</td>
                </tr>
                <tr>
                    <td><kbd>Esc</kbd></td>
                    <td>Close help / Clear search</td>
                </tr>
                <tr>
                    <td><kbd>Ctrl+1-4</kbd></td>
                    <td>Switch search provider</td>
                </tr>
                {% if config.ENABLE_EDITING %}
                <tr>
                    <td><kbd>e</kbd></td>
                    <td>Toggle edit mode</td>
                </tr>
                <tr>
                    <td><kbd>Ctrl+↑</kbd></td>
                    <td>Move widget up (in edit mode)</td>
                </tr>
                <tr>
                    <td><kbd>Ctrl+↓</kbd></td>
                    <td>Move widget down (in edit mode)</td>
                </tr>
                {% endif %}
            </table>
            <p style="margin-top: 20px; text-align: center; color: {{ colors.color8 }};">
                Press <kbd>Esc</kbd> to close
            </p>
        </div>
    </div>

    {% if config.ENABLE_EDITING %}
    <!-- Edit Modal -->
    <div class="modal-overlay" id="editModal">
        <div class="modal-content">
            <h2 id="modalTitle">Edit Item</h2>
            <form id="editForm">
                <div class="form-group">
                    <label for="itemName">Name</label>
                    <input type="text" id="itemName" required>
                </div>
                <div class="form-group" id="urlGroup">
                    <label for="itemUrl">URL</label>
                    <input type="url" id="itemUrl">
                </div>
                <div class="form-group">
                    <label for="itemIcon">Icon (emoji or leave empty for favicon)</label>
                    <input type="text" id="itemIcon" maxlength="4" placeholder="Leave empty for favicon">
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Confirm Modal -->
    <div class="modal-overlay" id="confirmModal">
        <div class="modal-content">
            <h2>Confirm Action</h2>
            <p id="confirmMessage">Are you sure?</p>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeConfirmModal()">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmButton">Confirm</button>
            </div>
        </div>
    </div>
    {% endif %}

    {% if config.ENABLE_WEBSOCKET %}
    <!-- Socket.IO client library (local with CDN fallback) -->
    <script src="{{ url_for('assets.socket_io') }}" 
            onerror="this.onerror=null; this.src='https://cdn.socket.io/4.7.2/socket.io.min.js'; console.log('Using CDN fallback for Socket.IO');">
    </script>
    <!-- WebSocket client -->
    <script src="{{ url_for('assets.websocket_client') }}"></script>
    {% endif %}

    <script src="{{ url_for('assets.scripts') }}"></script>
</body>
</html>
