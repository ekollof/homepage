/**
 * Module: System Stats Sidebar
 * Handles real-time system statistics display
 */

{% if config.ENABLE_SYSTEM_STATS %}
// System stats state
let systemStatsVisible = false;
let systemStatsInterval = null;
let systemStatsPosition = 'left';
let cpuHistory = [];
let memoryHistory = [];
const maxHistoryPoints = 20;

function toggleSystemStats() {
    systemStatsVisible = !systemStatsVisible;
    const sidebar = document.getElementById('systemStatsSidebar');
    const expandedContent = document.getElementById('statsExpandedContent');
    const slimBar = document.getElementById('statsSlimBar');

    if (systemStatsVisible) {
        sidebar.classList.add('expanded');
        expandedContent.style.display = 'block';
        slimBar.style.display = 'none';
        updateSystemStats();
        systemStatsInterval = setInterval(updateSystemStats, 5000);
    } else {
        sidebar.classList.remove('expanded');
        expandedContent.style.display = 'none';
        slimBar.style.display = 'block';
        if (systemStatsInterval) {
            clearInterval(systemStatsInterval);
            systemStatsInterval = null;
        }
    }
}

function setStatsPosition(position) {
    const sidebar = document.getElementById('systemStatsSidebar');
    sidebar.classList.remove('position-left', 'position-right', 'position-top', 'position-bottom');
    sidebar.classList.add(`position-${position}`);
    systemStatsPosition = position;
    localStorage.setItem('statsPosition', position);
}

function updateSystemStats() {
    fetch('/api/system-stats')
        .then(response => response.json())
        .then(data => {
            if (data.error) {
                console.error('System stats error:', data.error);
                return;
            }

            // Update icon panel and slim bar
            const cpuPercent = `${Math.round(data.cpu_percent)}%`;
            const memoryPercent = `${Math.round(data.memory_percent)}%`;
            const diskPercent = `${Math.round(data.disk_percent)}%`;
            const networkTotal = `${(data.network_sent_mb + data.network_recv_mb).toFixed(1)}M`;

            document.getElementById('cpuIconValue').textContent = cpuPercent;
            document.getElementById('memoryIconValue').textContent = memoryPercent;
            document.getElementById('diskIconValue').textContent = diskPercent;
            document.getElementById('networkIconValue').textContent = networkTotal;

            document.getElementById('cpuSlimValue').textContent = cpuPercent;
            document.getElementById('memorySlimValue').textContent = memoryPercent;
            document.getElementById('diskSlimValue').textContent = diskPercent;
            document.getElementById('networkSlimValue').textContent = networkTotal;

            // Update CPU section
            updateStatBar('cpuBar', data.cpu_percent);
            document.getElementById('cpuValue').textContent = `${Math.round(data.cpu_percent)}%`;
            document.getElementById('cpuCores').textContent = `${data.cpu_count} cores`;
            
            // CPU frequency - try psutil first, then FreeBSD power mgmt, then hide
            let cpuFreqText = '';
            if (data.cpu_freq_current) {
                cpuFreqText = `${Math.round(data.cpu_freq_current)} MHz`;
            } else if (data.power_management?.freebsd?.cpu_freq?.current) {
                cpuFreqText = `${data.power_management.freebsd.cpu_freq.current} MHz`;
            }
            
            const cpuFreqElement = document.getElementById('cpuFreq');
            if (cpuFreqText) {
                cpuFreqElement.textContent = cpuFreqText;
                cpuFreqElement.style.display = 'inline';
            } else {
                cpuFreqElement.style.display = 'none';
            }

            // Update CPU sparkline
            cpuHistory.push(data.cpu_percent);
            if (cpuHistory.length > maxHistoryPoints) cpuHistory.shift();
            updateSparkline('cpuSparklinePath', cpuHistory);

            // Update Memory section
            updateStatBar('memoryBar', data.memory_percent);
            document.getElementById('memoryValue').textContent = `${Math.round(data.memory_percent)}%`;
            document.getElementById('memoryUsed').textContent = `${Math.round(data.memory_used_mb)} MB`;
            document.getElementById('memoryTotal').textContent = `${Math.round(data.memory_total_mb)} MB`;

            // Update Memory sparkline
            memoryHistory.push(data.memory_percent);
            if (memoryHistory.length > maxHistoryPoints) memoryHistory.shift();
            updateSparkline('memorySparklinePath', memoryHistory);

            // Update Disk section
            updateStatBar('diskBar', data.disk_percent);
            document.getElementById('diskValue').textContent = `${Math.round(data.disk_percent)}%`;
            document.getElementById('diskUsed').textContent = `${data.disk_used_gb.toFixed(1)} GB`;
            document.getElementById('diskTotal').textContent = `${data.disk_total_gb.toFixed(1)} GB`;

            // Update Network section
            document.getElementById('networkRecv').textContent = `${data.network_recv_mb.toFixed(1)} MB`;
            document.getElementById('networkSent').textContent = `${data.network_sent_mb.toFixed(1)} MB`;

            // Update Battery section (conditional)
            if (data.battery) {
                const batterySection = document.getElementById('batterySection');
                batterySection.style.display = 'block';
                updateStatBar('batteryBar', data.battery.percent);
                document.getElementById('batteryValue').textContent = `${Math.round(data.battery.percent)}%`;

                let statusText = data.battery.plugged ? '🔌 Charging' : '🔋 Discharging';
                if (data.battery.time_left) {
                    const hours = Math.floor(data.battery.time_left / 3600);
                    const minutes = Math.floor((data.battery.time_left % 3600) / 60);
                    statusText += ` (${hours}h ${minutes}m)`;
                }
                document.getElementById('batteryStatus').textContent = statusText;
            }

            // Update System info
            document.getElementById('processCount').textContent = data.processes;
            document.getElementById('uptime').textContent = formatUptime(data.uptime_seconds);

            // Update Temperature (conditional)
            if (data.temperature_avg !== undefined) {
                document.getElementById('temperatureInfo').style.display = 'inline';
                document.getElementById('temperature').textContent = Math.round(data.temperature_avg);
            }

            // Update Power Management section (Linux/FreeBSD)
            if (data.power_management) {
                updatePowerManagement(data.power_management);
            }

            // Update ZFS section (if available)
            if (data.zfs) {
                updateZFSStats(data.zfs);
            }
        })
        .catch(error => {
            console.error('Failed to fetch system stats:', error);
        });
}

function updateStatBar(barId, percentage) {
    const bar = document.getElementById(barId);
    bar.style.setProperty('--bar-width', `${percentage}%`);
}

function updateSparkline(pathId, data) {
    if (data.length === 0) return;

    const points = data.map((value, index) => {
        const x = (index / (maxHistoryPoints - 1)) * 120;
        const y = 30 - (value / 100) * 30;
        return `${x},${y}`;
    }).join(' ');

    document.getElementById(pathId).setAttribute('points', points);
}

function formatUptime(seconds) {
    const days = Math.floor(seconds / 86400);
    const hours = Math.floor((seconds % 86400) / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);

    if (days > 0) return `${days}d ${hours}h ${minutes}m`;
    if (hours > 0) return `${hours}h ${minutes}m`;
    return `${minutes}m`;
}

function updatePowerManagement(powerMgmt) {
    const section = document.getElementById('powerManagementSection');
    if (!section) return;

    section.style.display = 'block';

    // Handle FreeBSD power management
    if (powerMgmt.freebsd) {
        updateFreeBSDPowerManagement(powerMgmt.freebsd);
        return;
    }

    // Update CPU Governor info (Linux)
    const governors = powerMgmt.governors;
    if (governors && governors.available) {
        const governorInfo = document.getElementById('governorInfo');
        const governorSelect = document.getElementById('governorSelect');
        const powerSavingStatus = document.getElementById('powerSavingStatus');

        // Update power saving indicator
        if (powerSavingStatus) {
            powerSavingStatus.textContent = governors.power_saving_enabled ? '⚡ Enabled' : '🔋 Disabled';
            powerSavingStatus.className = governors.power_saving_enabled ? 'power-saving-enabled' : 'power-saving-disabled';
        }

        // Update current governor display
        if (governors.current_governor && governorInfo) {
            governorInfo.textContent = governors.current_governor;
        }

        // Populate governor dropdown
        if (governors.available_governors && governorSelect) {
            governorSelect.innerHTML = '';
            governors.available_governors.forEach(gov => {
                const option = document.createElement('option');
                option.value = gov;
                option.textContent = gov;
                if (gov === governors.current_governor) {
                    option.selected = true;
                }
                governorSelect.appendChild(option);
            });
        }
    }

    // Update I/O Scheduler info
    const ioSchedulers = powerMgmt.io_schedulers;
    if (ioSchedulers && ioSchedulers.available) {
        const schedulerContainer = document.getElementById('schedulerContainer');
        if (schedulerContainer && ioSchedulers.devices) {
            schedulerContainer.innerHTML = '';
            ioSchedulers.devices.forEach(device => {
                const deviceDiv = document.createElement('div');
                deviceDiv.className = 'scheduler-device';
                deviceDiv.innerHTML = `
                    <div class="stat-info">
                        <strong>${device.device}:</strong> ${device.current_scheduler || 'N/A'}
                    </div>
                    <select class="scheduler-select" data-device="${device.device}">
                        ${device.available_schedulers.map(sched => 
                            `<option value="${sched}" ${sched === device.current_scheduler ? 'selected' : ''}>${sched}</option>`
                        ).join('')}
                    </select>
                `;
                schedulerContainer.appendChild(deviceDiv);

                // Add change event listener
                const select = deviceDiv.querySelector('.scheduler-select');
                select.addEventListener('change', (e) => {
                    setIOScheduler(device.device, e.target.value);
                });
            });
        }
    }
}

function updateFreeBSDPowerManagement(freebsdPower) {
    const section = document.getElementById('powerManagementSection');
    if (!section) return;

    // Clear existing content and rebuild for FreeBSD
    section.innerHTML = '<div class="stat-label">⚡ Power Management (FreeBSD)</div>';

    // CPU Frequency section
    if (freebsdPower.cpu_freq) {
        const cpuFreqDiv = document.createElement('div');
        cpuFreqDiv.className = 'power-mgmt-item';
        
        const currentFreq = freebsdPower.cpu_freq.current || 'N/A';
        cpuFreqDiv.innerHTML = `
            <div class="stat-info">
                <strong>CPU Frequency:</strong> ${currentFreq} MHz
            </div>
        `;

        if (freebsdPower.cpu_freq.available_levels && freebsdPower.cpu_freq.available_levels.length > 0) {
            const freqSelect = document.createElement('select');
            freqSelect.className = 'freq-select';
            freqSelect.id = 'freebsdFreqSelect';
            
            freebsdPower.cpu_freq.available_levels.forEach(freq => {
                const option = document.createElement('option');
                option.value = freq;
                option.textContent = `${freq} MHz`;
                if (freq === currentFreq) {
                    option.selected = true;
                }
                freqSelect.appendChild(option);
            });

            freqSelect.addEventListener('change', (e) => {
                setFreeBSDCPUFreq(parseInt(e.target.value));
            });

            cpuFreqDiv.appendChild(freqSelect);
        }

        section.appendChild(cpuFreqDiv);
    }

    // Powerd daemon status
    if (freebsdPower.powerd) {
        const powerdDiv = document.createElement('div');
        powerdDiv.className = 'power-mgmt-item';
        
        const running = freebsdPower.powerd.running ? '✓' : '✗';
        const enabled = freebsdPower.powerd.enabled ? 'Enabled' : 'Disabled';
        
        let statusHTML = `
            <div class="stat-info">
                <strong>powerd:</strong> ${enabled} ${running}
            </div>
        `;

        if (freebsdPower.powerd.ac_mode || freebsdPower.powerd.battery_mode) {
            statusHTML += `
                <div class="stat-info" style="margin-left: 1em; font-size: 0.9em;">
                    AC: ${freebsdPower.powerd.ac_mode || 'N/A'} | 
                    Battery: ${freebsdPower.powerd.battery_mode || 'N/A'}
                </div>
            `;
        }

        powerdDiv.innerHTML = statusHTML;
        section.appendChild(powerdDiv);
    }

    // Battery status (if available)
    if (freebsdPower.battery_life !== undefined) {
        const batteryDiv = document.createElement('div');
        batteryDiv.className = 'power-mgmt-item';
        
        const acStatus = freebsdPower.ac_connected ? '🔌 AC' : '🔋 Battery';
        batteryDiv.innerHTML = `
            <div class="stat-info">
                <strong>Power:</strong> ${acStatus} (${freebsdPower.battery_life}%)
            </div>
        `;
        section.appendChild(batteryDiv);
    }
}

function setFreeBSDCPUFreq(freq) {
    fetch('/api/system-stats/freebsd-cpu-freq', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ freq: freq })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            console.log('CPU frequency set:', data.message);
            // Refresh stats to show new values
            setTimeout(updateSystemStats, 500);
        } else {
            console.error('Failed to set CPU frequency:', data.message);
            alert(`Failed to set CPU frequency: ${data.message}\n\nYou may need to run with sudo/doas privileges or adjust permissions.`);
        }
    })
    .catch(error => {
        console.error('Error setting CPU frequency:', error);
        alert('Error setting CPU frequency. Check console for details.');
    });
}

function setCPUGovernor(governor) {
    fetch('/api/system-stats/cpu-governor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ governor: governor })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            console.log('CPU governor set:', data.message);
            // Refresh stats to show new values
            setTimeout(updateSystemStats, 500);
        } else {
            console.error('Failed to set CPU governor:', data.message);
            alert(`Failed to set CPU governor: ${data.message}\n\nYou may need to run with sudo privileges or adjust permissions.`);
        }
    })
    .catch(error => {
        console.error('Error setting CPU governor:', error);
        alert('Error setting CPU governor. Check console for details.');
    });
}

function setIOScheduler(device, scheduler) {
    fetch('/api/system-stats/io-scheduler', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ device: device, scheduler: scheduler })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            console.log('I/O scheduler set:', data.message);
            // Refresh stats to show new values
            setTimeout(updateSystemStats, 500);
        } else {
            console.error('Failed to set I/O scheduler:', data.message);
            alert(`Failed to set I/O scheduler: ${data.message}\n\nYou may need to run with sudo privileges or adjust permissions.`);
        }
    })
    .catch(error => {
        console.error('Error setting I/O scheduler:', error);
        alert('Error setting I/O scheduler. Check console for details.');
    });
}

function updateZFSStats(zfsData) {
    const section = document.getElementById('zfsSection');
    if (!section) return;

    section.style.display = 'block';

    // Update ARC stats
    if (zfsData.arc) {
        const arc = zfsData.arc;
        
        document.getElementById('arcSize').textContent = `${arc.size_mb} MB`;
        document.getElementById('arcMax').textContent = `${arc.max_mb} MB`;
        document.getElementById('arcPercent').textContent = `${arc.size_percent}%`;
        document.getElementById('arcHitRatio').textContent = `${arc.hit_ratio}%`;
        
        // Update ARC size bar
        updateStatBar('arcBar', arc.size_percent);
        
        // Color code hit ratio (green >95%, yellow 85-95%, red <85%)
        const hitRatioElement = document.getElementById('arcHitRatio');
        hitRatioElement.style.color = arc.hit_ratio > 95 ? 'var(--color2)' : 
                                       arc.hit_ratio > 85 ? 'var(--color3)' : 
                                       'var(--color1)';
    }

    // Update pool information
    if (zfsData.pools && zfsData.pools.length > 0) {
        const poolsContainer = document.getElementById('zfsPools');
        poolsContainer.innerHTML = '';
        
        zfsData.pools.forEach(pool => {
            const poolDiv = document.createElement('div');
            poolDiv.className = 'zfs-pool';
            
            // Health indicator with emoji
            const healthIcon = pool.health === 'ONLINE' ? '✓' : 
                             pool.health === 'DEGRADED' ? '⚠' : '✗';
            const healthColor = pool.health === 'ONLINE' ? 'var(--color2)' : 
                              pool.health === 'DEGRADED' ? 'var(--color3)' : 
                              'var(--color1)';
            
            poolDiv.innerHTML = `
                <div class="stat-info">
                    <strong>${pool.name}:</strong> 
                    <span style="color: ${healthColor}">${healthIcon} ${pool.health}</span>
                </div>
                <div class="stat-info" style="margin-left: 1em; font-size: 0.9em;">
                    ${pool.allocated} / ${pool.size} (${pool.free} free)
                </div>
            `;
            
            poolsContainer.appendChild(poolDiv);
        });
    }
}

// Initialize system stats sidebar
document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('systemStatsSidebar');
    setStatsPosition(systemStatsPosition);
    // Start updating slim bar immediately
    updateSystemStats();
    setInterval(updateSystemStats, 5000);

    // Add event listener for governor select
    const governorSelect = document.getElementById('governorSelect');
    if (governorSelect) {
        governorSelect.addEventListener('change', (e) => {
            setCPUGovernor(e.target.value);
        });
    }
});

// Add keyboard shortcut for system stats (s key)
document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 's' || e.key === 'S') {
        e.preventDefault();
        toggleSystemStats();
    }
});



