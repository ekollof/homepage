/**
 * Core constants templated with Jinja2
 */

export const CLOCK_FORMAT = '{{ clock_format }}';
export const RELOAD_INTERVAL = {{ reload_interval }};

// Feature flags
export const ENABLE_WEATHER = {{ 'true' if config.ENABLE_WEATHER else 'false' }};
export const ENABLE_RSS = {{ 'true' if config.ENABLE_RSS else 'false' }};
export const ENABLE_SYSTEM_STATS = {{ 'true' if config.ENABLE_SYSTEM_STATS else 'false' }};
export const ENABLE_EDITING = {{ 'true' if config.ENABLE_EDITING else 'false' }};

// System stats configuration
{% if config.ENABLE_SYSTEM_STATS %}
export const SYSTEM_STATS_POSITION = '{{ config.SYSTEM_STATS_POSITION }}';
export const SYSTEM_STATS_REFRESH_INTERVAL = {{ config.SYSTEM_STATS_REFRESH_INTERVAL * 1000 }};
{% endif %}

// Search providers
export const SEARCH_URLS = {
    'brave': 'https://search.brave.com/search?q=',
    'google': 'https://www.google.com/search?q=',
    'duckduckgo': 'https://duckduckgo.com/?q=',
    'bing': 'https://www.bing.com/search?q='
};
