# Homepage Environment Variables
# Copy this file to .env and customize for your setup

# Flask Configuration
HOMEPAGE_HOST=127.0.0.1
HOMEPAGE_PORT=5000
HOMEPAGE_DEBUG=False
HOMEPAGE_ENV=production
HOMEPAGE_SECRET_KEY=change-this-to-a-random-secret-key

# Cache Settings
HOMEPAGE_ENABLE_CACHE=True
HOMEPAGE_CACHE_TTL=5

# Feature Flags
HOMEPAGE_ENABLE_COMPRESSION=True
HOMEPAGE_ENABLE_METRICS=True
HOMEPAGE_ENABLE_WEATHER=False
HOMEPAGE_ENABLE_RSS=False

# Auto-reload Settings
HOMEPAGE_RELOAD_INTERVAL=2000
HOMEPAGE_WATCH_FILES=True

# Clock Settings (12 or 24)
HOMEPAGE_CLOCK_FORMAT=24

# Logging
HOMEPAGE_LOG_LEVEL=INFO

# Weather Settings (optional, requires ENABLE_WEATHER=True)
# Provider: openmeteo (free, no API key) or openweathermap (requires API key)
HOMEPAGE_WEATHER_PROVIDER=openmeteo
HOMEPAGE_WEATHER_API_KEY=
# Optional: Specify location as "lat,lon" or leave empty for GeoIP auto-detection
HOMEPAGE_WEATHER_LOCATION=
# Units: metric (Celsius, km/h) or imperial (Fahrenheit, mph)
HOMEPAGE_WEATHER_UNITS=metric
# GeoIP provider: maxmind (local db, fastest), ipapi (30k/month), or ip-api (45/min)
HOMEPAGE_GEOIP_PROVIDER=maxmind

# RSS Feed Settings (optional, requires ENABLE_RSS=True)
# Feeds separated by | character
# Example: HOMEPAGE_RSS_FEEDS=https://news.ycombinator.com/rss|https://feeds.bbci.co.uk/news/rss.xml
HOMEPAGE_RSS_FEEDS=
HOMEPAGE_RSS_MAX_ITEMS=5
HOMEPAGE_RSS_CACHE_TTL=300
